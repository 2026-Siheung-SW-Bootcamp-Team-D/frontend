# 이 파일을 복사해서 .env.local 을 만드세요.
#
#   Windows(PowerShell):  copy .env.example .env.local
#   macOS / Linux:        cp .env.example .env.local
#
# .env.local 은 .gitignore 에 등록되어 있어 GitHub에 올라가지 않습니다.
# 이 .env.example 만 저장소에 올라갑니다 — "어떤 값이 필요한지"는 팀 전체가 알아야 하지만
# "그 값이 무엇인지"는 각자 자기 컴퓨터에만 있어야 하기 때문입니다.


# ─────────────────────────────────────────────────────────────
# VITE_ 접두사에 대해 (중요)
# ─────────────────────────────────────────────────────────────
# Vite는 VITE_ 로 시작하는 변수만 앱 코드로 전달합니다.
# 코드에서는 import.meta.env.VITE_API_BASE_URL 처럼 읽습니다.
#
# ⚠️ VITE_ 변수는 빌드할 때 결과물 파일 안에 그대로 박힙니다.
#    브라우저 개발자 도구로 누구나 꺼내 볼 수 있습니다.
#    → 비밀번호, API 키, 토큰을 여기에 넣으면 안 됩니다.
#    → 비밀이 필요한 일은 백엔드 서버가 대신 처리합니다.
#
# 접두사가 없는 변수는 앱 코드에서 아예 읽히지 않습니다.


# 백엔드 API Base URL. `/api/v1`까지 포함해야 하며 API 모듈은 `/boards` 같은 자원 경로만 붙입니다.
# 로컬에서 backend 를 함께 띄워 개발할 때의 기본값입니다.
# 배포(Vercel)에서는 이 파일이 쓰이지 않습니다 — Vercel 대시보드에 직접 등록합니다.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Kakao Maps JavaScript SDK의 공개 키입니다. REST API 키나 다른 서버 비밀 키를 넣지 마세요.
# Kakao Developers Web 플랫폼에는 localhost, yeondang.com, www.yeondang.com과 승인된 preview 도메인을 등록해야 합니다.
# 키가 없거나 SDK가 차단돼도 화면은 "지도 사용 불가" fallback으로 계속 동작합니다.
VITE_KAKAO_JAVASCRIPT_KEY=
